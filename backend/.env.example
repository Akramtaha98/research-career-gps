# Server
PORT=4000
NODE_ENV=development

# Set to "true" to run without a real Postgres connection (in-memory demo store).
# Useful for local testing before you provision Supabase/Postgres.
DEMO_MODE=true

# PostgreSQL (Supabase or any Postgres-compatible host)
DATABASE_URL=postgresql://user:password@localhost:5432/research_career_gps
PGSSL=false

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Google Sign-In — create an OAuth Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials. No client secret needed;
# the frontend uses this same ID as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Apple Sign In — requires a paid Apple Developer Program membership. Create
# a Services ID at https://developer.apple.com/account/resources/identifiers
# and enable "Sign in with Apple" with your domain + return URL registered.
# No client secret needed for identity verification (only for refresh tokens,
# which this app doesn't use). The frontend uses this same ID as
# VITE_APPLE_CLIENT_ID.
APPLE_CLIENT_ID=

# Semantic Scholar API (no key required, but you can add one to raise rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# CORS
FRONTEND_ORIGIN=http://localhost:5173
