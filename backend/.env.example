# Server
PORT=4000
NODE_ENV=development

# Set to "true" to run without a real Postgres connection (in-memory demo store).
# Useful for local testing before you provision Supabase/Postgres.
DEMO_MODE=true

# PostgreSQL (Supabase or any Postgres-compatible host)
DATABASE_URL=postgresql://user:password@localhost:5432/research_career_gps
PGSSL=false

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Google Sign-In — create an OAuth Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials. No client secret needed;
# the frontend uses this same ID as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Semantic Scholar API (no key required, but you can add one to raise rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Stripe (Pro plan paywall) — create your own account at https://dashboard.stripe.com.
# Get keys from https://dashboard.stripe.com/test/apikeys (use TEST keys until
# you're ready to accept real payments). Create a recurring Price under
# Products for "Pro" ($4.99/mo suggested) and use its price ID below.
# See docs/SETUP.md for the full walkthrough, including webhook setup.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Used to build Stripe Checkout success/cancel redirect URLs.
FRONTEND_URL=http://localhost:5173
