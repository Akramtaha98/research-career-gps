# Server
PORT=4000
NODE_ENV=development

# Set to "true" to run without a real Postgres connection (in-memory demo store).
# Useful for local testing before you provision Supabase/Postgres.
DEMO_MODE=true

# PostgreSQL (Supabase or any Postgres-compatible host)
DATABASE_URL=postgresql://user:password@localhost:5432/research_career_gps
PGSSL=false

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Google Sign-In — create an OAuth Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials. No client secret needed;
# the frontend uses this same ID as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Semantic Scholar API (no key required, but you can add one to raise rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex (primary researcher-data source, no key required) — optional but
# recommended: your email, so OpenAlex puts requests in its faster "polite pool".
OPENALEX_MAILTO=

# Sign in with ORCID — create a free public API app at
# https://orcid.org/developer-tools (or https://sandbox.orcid.org/developer-tools
# to test against ORCID's sandbox first). Register redirect URI:
#   <this backend's public URL>/api/auth/orcid/callback
# then paste the Client ID + Client Secret it gives you below. The exact
# same redirect URI must also be set as VITE_ORCID_REDIRECT_URI on the
# frontend. See docs/SETUP.md for the full walkthrough.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=http://localhost:4000/api/auth/orcid/callback
ORCID_SANDBOX=false

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Stripe (Pro plan paywall) — create your own account at https://dashboard.stripe.com.
# Get keys from https://dashboard.stripe.com/test/apikeys (use TEST keys until
# you're ready to accept real payments). Create a recurring Price under
# Products for "Pro" ($4.99/mo suggested) and use its price ID below.
# See docs/SETUP.md for the full walkthrough, including webhook setup.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Used to build Stripe Checkout success/cancel redirect URLs, and the
# forgot-password reset link sent by email.
FRONTEND_URL=http://localhost:5173

# Resend (forgot-password emails) — create a free account at
# https://resend.com, verify a sending domain (or use their shared
# onboarding@resend.dev sender for quick testing), then create an API key.
# See docs/SETUP.md for the full walkthrough.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
