# Server
PORT=4000
NODE_ENV=development

# Set to "true" to run without a real Postgres connection (in-memory demo store).
# Useful for local testing before you provision Supabase/Postgres.
DEMO_MODE=true

# PostgreSQL (Supabase or any Postgres-compatible host)
DATABASE_URL=postgresql://user:password@localhost:5432/research_career_gps
PGSSL=false

# Auth
# Set NODE_ENV=production on your real deployment (Railway) — it controls
# both the CORS wildcard warning below and whether unexpected server errors
# leak their raw message to clients (see utils/sendError.js).
#
# JWT_SECRET: generate with `openssl rand -hex 32` or similar — must be
# long and random. server.js warns loudly on boot if this is missing, short
# (<32 chars), or a known placeholder, since anyone who knows/guesses it can
# forge a login token for any account.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Test-only escape hatch for the rate limiters below (server.js's global
# limiter + routes/auth.js's authLimiter + routes/researchers.js's
# searchLimiter) — the integration test suite makes far more requests
# against these routes in one run than a real client legitimately would.
# NEVER set this to "true" on a real deployment.
DISABLE_RATE_LIMIT=false

# Google Sign-In — create an OAuth Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials. No client secret needed;
# the frontend uses this same ID as VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Semantic Scholar API (no key required, but you can add one to raise rate limits)
SEMANTIC_SCHOLAR_API_KEY=

# OpenAlex (primary researcher-data source, no key required) — optional but
# recommended: your email, so OpenAlex puts requests in its faster "polite pool".
OPENALEX_MAILTO=

# Sign in with ORCID — create a free public API app at
# https://orcid.org/developer-tools (or https://sandbox.orcid.org/developer-tools
# to test against ORCID's sandbox first). Register redirect URI:
#   <this backend's public URL>/api/auth/orcid/callback
# then paste the Client ID + Client Secret it gives you below. The exact
# same redirect URI must also be set as VITE_ORCID_REDIRECT_URI on the
# frontend. See docs/SETUP.md for the full walkthrough.
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=http://localhost:4000/api/auth/orcid/callback
ORCID_SANDBOX=false

# CORS — one origin, or a comma-separated list (e.g. when running both a
# custom domain and the *.vercel.app one, or adding a preview deployment
# URL): "https://yourdomain.com,https://research-career-gps.vercel.app".
# Leaving this unset falls back to "*" (any origin) — fine for local dev,
# but server.js prints a startup warning if that fallback is ever active
# with NODE_ENV=production, since an open CORS policy in production is
# meant to be a temporary state, not a permanent setting.
FRONTEND_ORIGIN=http://localhost:5173

# Stripe (Pro plan paywall) — create your own account at https://dashboard.stripe.com.
# Get keys from https://dashboard.stripe.com/test/apikeys (use TEST keys until
# you're ready to accept real payments). Create a recurring Price under
# Products for "Pro" ($4.99/mo suggested) and use its price ID below.
# See docs/SETUP.md for the full walkthrough, including webhook setup.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Used to build Stripe Checkout success/cancel redirect URLs, and the
# forgot-password reset link sent by email.
FRONTEND_URL=http://localhost:5173

# Resend (forgot-password emails + Contact Us notifications) — create a free
# account at https://resend.com, verify a sending domain (or use their shared
# onboarding@resend.dev sender for quick testing), then create an API key.
# See docs/SETUP.md for the full walkthrough.
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Where "Contact us" form submissions get emailed to (in addition to always
# being stored in the contact_messages table). Without this set (or without
# RESEND_API_KEY), messages are still saved — just not emailed to you.
CONTACT_NOTIFY_EMAIL=akramtaha30@gmail.com

# Timeline feature: daily cron (runs at 03:00 UTC) that refreshes any
# researcher whose last snapshot is 30+ days old, so Timeline history keeps
# growing even for users who never click "Refresh" themselves. Set to
# "false" to disable (e.g. local dev, or if you only want one server
# instance running it). See services/snapshotScheduler.js.
ENABLE_SNAPSHOT_CRON=true

# Weekly goal-progress digest email: cron (runs Monday 13:00 UTC) that emails
# every digest_subscribed + email_verified user their progress toward the
# H-index goal they saved on the Predictor page. Uses the same
# RESEND_API_KEY/EMAIL_FROM as every other email. Set to "false" to disable,
# same reasoning as ENABLE_SNAPSHOT_CRON. See services/digestScheduler.js.
ENABLE_DIGEST_CRON=true

# This backend's own public URL (no trailing slash) — used to build the
# one-click "unsubscribe from weekly updates" link embedded in the digest
# email (GET /api/auth/unsubscribe-digest). Same origin as ORCID_REDIRECT_URI
# above, just without the path.
API_BASE_URL=http://localhost:4000/api
