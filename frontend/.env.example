VITE_API_URL=http://localhost:4000/api

# Google Sign-In — same Client ID as the backend's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

# Apple Sign In — same Services ID as the backend's APPLE_CLIENT_ID.
# Requires a paid Apple Developer account + domain verification to work;
# see docs/SETUP.md. The button won't render until this is set.
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=http://localhost:5173
