VITE_API_URL=http://localhost:4000/api

# Google Sign-In — same Client ID as the backend's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=

# Sign in with ORCID — same Client ID as the backend's ORCID_CLIENT_ID (the
# Client ID itself is not secret; only ORCID_CLIENT_SECRET, kept backend-only,
# is). VITE_ORCID_REDIRECT_URI must exactly match ORCID_REDIRECT_URI on the
# backend and the redirect URI registered in the ORCID developer portal.
VITE_ORCID_CLIENT_ID=
VITE_ORCID_REDIRECT_URI=http://localhost:4000/api/auth/orcid/callback
VITE_ORCID_SANDBOX=false
